---
import { SITE_TITLE, SOCIAL_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>&copy; {year} {SITE_TITLE}</p>

    <nav aria-label="Footer">
      {SOCIAL_LINKS.map((link) => <a href={link.href} target="_blank" rel="me noopener noreferrer">{link.label}</a>)}
    </nav>
  </div>
</footer>
