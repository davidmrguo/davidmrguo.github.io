---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";
import { HOME_TITLE, WELCOMES } from "../consts";

const posts = await getPublishedPosts();
const recent = posts.slice(0, 5);
---

<BaseLayout>
  <h1 class="page-title">{HOME_TITLE}</h1>

  <p class="page-intro welcome-line">
    <span class="sr-only">
      Welcome, in each language Mac OS X Snow Leopard shipped in.
    </span>
    <span class="welcome-cycle" aria-hidden="true">
      {
        WELCOMES.map((welcome, i) => (
          <span lang={welcome.lang} style={`--welcome-index:${i}`}>
            {welcome.text}
          </span>
        ))
      }
    </span>
  </p>

  <div class="section-head">
    <h2>Recent posts</h2>
    {posts.length > recent.length && <a href="/posts/">All posts &rarr;</a>}
  </div>

  {
    recent.length > 0 ? (
      <ul class="post-list">
        {recent.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    ) : (
      <p class="empty-note">
        No posts yet. Add a markdown file to <code>src/content/posts/</code> and it
        will show up here.
      </p>
    )
  }
</BaseLayout>
